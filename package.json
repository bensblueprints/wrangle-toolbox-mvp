{
  "name": "wrangle",
  "productName": "Wrangle",
  "version": "1.0.0",
  "description": "The offline developer data toolbox — convert, validate, format, query and diff JSON/CSV/YAML/XML, decode JWTs, encode, hash, generate UUIDs, test regex, convert timestamps. Pay once, own it forever.",
  "author": "Ben (bensblueprints)",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "test": "node test/smoke.js",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "fast-xml-parser": "^4.5.0",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.2.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.bensblueprints.wrangle",
    "productName": "Wrangle",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "src/lib/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
